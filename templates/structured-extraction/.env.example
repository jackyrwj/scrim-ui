# Vercel AI Gateway — one key, every model in lib/models.ts.
# Create one at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# To use a provider directly instead, install its package
# (e.g. `npm i @ai-sdk/openai`) and swap the `model` line in
# app/api/extract/route.ts. Nothing else in the template changes.
