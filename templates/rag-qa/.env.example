# Vercel AI Gateway — one key reaches both the chat model and the embedding
# model in lib/models.ts. Create one at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# To use a provider directly instead, install its package
# (e.g. `npm i @ai-sdk/openai`) and swap the two `model` lines in
# lib/models.ts. Nothing else in the template changes.
