# ---------------------------------------------------------------- the site
# Every absolute URL (canonicals, sitemap, registry endpoints) is built from this.
NEXT_PUBLIC_SITE_URL=https://scrimui.dev

# ------------------------------------------------------------------ payments
# The Stripe Payment Link for Pro. Create it in the Stripe dashboard, set its
# confirmation page to:
#   https://<your-site>/pro/success?session_id={CHECKOUT_SESSION_ID}
# Stripe substitutes the placeholder, and that is what lets the success page
# show the key immediately instead of only promising an email.
# Leave empty and the site says checkout is not live rather than dead-ending.
NEXT_PUBLIC_CHECKOUT_URL=

# Signing secret for the webhook endpoint (Workbench -> Webhooks -> Reveal).
# Subscribe the endpoint to: checkout.session.completed
#                            checkout.session.async_payment_succeeded
# Test and live mode have DIFFERENT secrets, and `stripe listen` prints a
# third one of its own — mixing them up is the usual cause of a failed
# signature check.
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------- storage
# Upstash Redis, over its REST API (no dependency, no connection pooling).
# Without these the site falls back to the SCRIM_PRO_LICENSE_KEYS list below
# and REFUSES to issue new licences — a webhook that cannot save a key returns
# 500 so Stripe retries, rather than taking money and losing the key.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --------------------------------------------------------------------- email
# Resend. The domain in LICENSE_EMAIL_FROM must be verified with Resend.
# Unset, keys are written to the server log instead of being lost.
RESEND_API_KEY=
LICENSE_EMAIL_FROM="Scrim UI <keys@scrimui.dev>"

# ----------------------------------------------------------------- local dev
# Comma-separated keys that always verify. Development and smoke tests only —
# these are read-only and can never be issued, refunded, or recovered.
SCRIM_PRO_LICENSE_KEYS=SCRIM-TEST-0000-0001
