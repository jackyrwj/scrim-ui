# ---------------------------------------------------------------- the site
# Every absolute URL (canonicals, sitemap, registry endpoints) is built from this.
NEXT_PUBLIC_SITE_URL=https://scrimui.dev

# ---------------------------------------------------------------------- auth
# Clerk application keys. Use the same Clerk instance in Preview and
# Production, or deliberately create separate instances for each environment.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# -------------------------------------------------------------- account data
# Neon/Postgres connection string. Apply db/migrations/001_accounts.sql before
# enabling checkout.
DATABASE_URL=

# ------------------------------------------------------------------ payments
# Server-created Checkout Sessions replace the old public Payment Link. Copy
# the secret API key and the one-time US$49 Price id from Stripe test/live mode.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Signing secret for the webhook endpoint (Workbench -> Webhooks -> Reveal).
# Subscribe the endpoint to: checkout.session.completed
#                            checkout.session.async_payment_succeeded
#                            charge.refunded
# Test and live mode have DIFFERENT secrets, and `stripe listen` prints a
# third one of its own — mixing them up is the usual cause of a failed
# signature check.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------- private Pro source
# Base URL of the private artifact build's `dist/` directory. The origin must
# require the bearer token below; neither value may use a NEXT_PUBLIC_ prefix.
PRO_ARTIFACT_BASE_URL=https://private-artifacts.example.com/scrim-ui-pro/
PRO_ARTIFACT_BEARER_TOKEN=

# --------------------------------------------------------------------- email
# Resend sends the account-access confirmation after the database transaction.
# The domain in LICENSE_EMAIL_FROM must be verified with Resend.
RESEND_API_KEY=
LICENSE_EMAIL_FROM="Scrim UI <keys@scrimui.dev>"
