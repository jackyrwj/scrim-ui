# DEMO DEPLOYMENT ONLY. The template's own .env.example needs just the first
# of these; the rest are the spend limits, and this build refuses to serve in
# production without them.

# Vercel AI Gateway — one key, every model in lib/models.ts.
AI_GATEWAY_API_KEY=

# Upstash Redis, for the per-IP rate limit in lib/rate-limit.ts. Without both
# of these the demo returns 503 in production rather than running uncapped.
# The same Upstash database the main site uses is fine — the keys are
# namespaced under demo:.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
